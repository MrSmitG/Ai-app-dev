{
  "name": "localmod",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first desktop studio for open-weight models",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "start": "node packages/engine/src/index.js --spawn-vite",
    "dev": "node packages/engine/src/index.js --spawn-vite",
    "dev:engine": "node packages/engine/src/index.js",
    "dev:ui": "npm --prefix apps/desktop run dev:ui -- --open",
    "cli": "node apps/cli/src/localmodd.js",
    "build": "npm --prefix apps/desktop run build"
  },
  "dependencies": {
    "mammoth": "^1.9.0",
    "pdf-parse": "^1.1.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.5.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "typescript": "^5.8.3",
    "vite": "^6.3.4"
  }
}
